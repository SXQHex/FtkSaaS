{
  "name": "ftksaas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "verify": "turbo run verify",
    "typecheck": "turbo run typecheck",
    "generate": "pnpm --filter @ftksaas/backend generate",
    "test": "turbo run test",
    "test:clean": "pnpm --filter @ftksaas/backend test:clean",
    "dev:backend": "pnpm --filter @ftksaas/backend dev:start",
    "stop:backend": "pnpm --filter @ftksaas/backend dev:stop",
    "test:frontend": "turbo run test --filter=@ftksaas/web --filter=@ftksaas/ui",
    "test:frontend:e2e": "turbo run test:e2e --filter=@ftksaas/web",
    "test:frontend:coverage": "turbo run test:coverage --filter=@ftksaas/web --filter=@ftksaas/ui",
    "test:backend": "turbo run test --filter=@ftksaas/backend",
    "check:frontend": "turbo run lint typecheck test build --filter=@ftksaas/web --filter=@ftksaas/ui",
    "dev:web": "turbo run dev --filter=@ftksaas/web",
    "build:web": "turbo run build --filter=@ftksaas/web",
    "check:quality": "turbo run quality --filter=@ftksaas/backend"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
