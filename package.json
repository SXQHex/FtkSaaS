{
  "name": "ftksaas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "verify": "turbo run verify",
    "typecheck": "turbo run typecheck",
    "generate": "pnpm --filter @ftksaas/backend generate",
    "test": "turbo run test",
    "test:clean": "pnpm --filter @ftksaas/backend test:clean",
    "dev:backend": "pnpm --filter @ftksaas/backend dev:start",
    "stop:backend": "pnpm --filter @ftksaas/backend dev:stop"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
