{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "nextjs"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["node_modules/**", ".next/**", "coverage/**", "next-env.d.ts"],
  "rules": {
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@ftksaas/backend", "@ftksaas/backend/**", "**/backend/**"],
            "message": "Use the public shared package contract; application internals are owned by their application."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/preferences.tsx"],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": ["src/app/api/auth/signup-check/route.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@ftksaas/backend",
                  "@ftksaas/backend/**",
                  "**/backend/**",
                  "!../../../../../../backend/transports/account-signup-gateway.mjs"
                ],
                "message": "Use the public shared package contract; application internals are owned by their application."
              }
            ]
          }
        ]
      }
    }
  ]
}
