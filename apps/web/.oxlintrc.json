{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "nextjs"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["node_modules/**", ".next/**", "coverage/**", "next-env.d.ts"],
  "rules": {
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/preferences.tsx"],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    }
  ]
}
