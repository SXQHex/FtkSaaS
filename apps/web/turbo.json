{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**", ".tmp/production-modules.json"],
      "env": [
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_APP_ORIGIN",
        "VITE_PUBLIC_GATEWAY_URL",
        "VITE_TURNSTILE_SITE_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test:e2e": {
      "env": [
        "$TURBO_EXTENDS$",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_APP_ORIGIN",
        "VITE_PUBLIC_GATEWAY_URL",
        "VITE_TURNSTILE_SITE_KEY"
      ]
    }
  }
}
