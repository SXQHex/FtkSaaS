{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_APP_ORIGIN",
        "NEXT_PUBLIC_SYNCFUSION_LICENSE_KEY"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/apps/backend/transports/account-signup-gateway.mjs",
        "$TURBO_ROOT$/apps/backend/scripts/p04-public-ingress.mjs",
        "$TURBO_ROOT$/apps/backend/scripts/uuid.mjs"
      ]
    }
  }
}
