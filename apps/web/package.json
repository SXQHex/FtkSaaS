{
  "name": "@ftksaas/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "oxlint --deny-warnings . && pnpm format:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:isolation": "node scripts/verify-isolation.mjs",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@ftksaas/api-contracts": "workspace:*",
    "@ftksaas/ui": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ftksaas/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
