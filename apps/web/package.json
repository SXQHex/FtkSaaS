{
  "name": "@ftksaas/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && pnpm check:bundle",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware . && pnpm format:check",
    "preview": "vite preview",
    "format": "oxfmt --config ../../.oxfmtrc.json .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "i18n:extract": "i18next-cli extract",
    "i18n:types": "i18next-cli types",
    "i18n:check": "i18next-cli extract --dry-run && i18next-cli status tr",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm test:ci",
    "typecheck": "tsc -b",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:external": "node scripts/playwright.mjs test --config playwright.external.config.ts && node scripts/check-test-results.mjs playwright test-reports/external-playwright.json",
    "test:e2e:install": "node scripts/playwright.mjs install chromium",
    "verify": "node scripts/verify.mjs",
    "test:ci": "vitest run --coverage --allowOnly=false --reporter=default --reporter=json --reporter=junit --outputFile.json=test-reports/vitest.json --outputFile.junit=test-reports/vitest.xml && node scripts/check-test-results.mjs vitest test-reports/vitest.json",
    "test:ci:guards": "node --test --test-concurrency=1 scripts/check-test-results.test.mjs scripts/ci-e2e.test.mjs scripts/verify.test.mjs scripts/test-local.test.mjs scripts/cloudflare.test.mjs",
    "test:e2e:ci": "node scripts/ci-e2e.mjs",
    "test:e2e:deps": "node scripts/playwright.mjs install-deps chromium",
    "audit:production": "node scripts/audit.mjs production",
    "audit:all": "node scripts/audit.mjs all",
    "verify:ci": "node scripts/verify.mjs",
    "knip": "knip",
    "check:bundle": "node --test scripts/production-policy.test.mjs && node scripts/check-production-bundle.mjs",
    "test:local": "node scripts/test-local.mjs",
    "test:isolation": "node scripts/verify-isolation.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@ftksaas/api-contracts": "workspace:*",
    "@ftksaas/ui": "workspace:*",
    "@fullcalendar/react": "7.1.5",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/devtools-event-client": "0.5.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "i18next": "27.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "recharts": "3.8.0",
    "temporal-polyfill": "1.0.8",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ftksaas/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "i18next-cli": "1.87.0",
    "jsdom": "31.0.0",
    "knip": "6.45.1",
    "msw": "3.0.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
