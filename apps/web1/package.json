{
  "name": "web1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run check:bundle",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "i18n:extract": "i18next-cli extract",
    "i18n:types": "i18next-cli types",
    "i18n:check": "i18next-cli extract --dry-run && i18next-cli status tr",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:e2e:install": "node scripts/playwright.mjs install chromium",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm run test:coverage && npm run test:e2e && npm run build",
    "test:ci": "vitest run --coverage --allowOnly=false --reporter=default --reporter=json --reporter=junit --outputFile.json=test-reports/vitest.json --outputFile.junit=test-reports/vitest.xml && node scripts/check-test-results.mjs vitest test-reports/vitest.json",
    "test:ci:guards": "node --test scripts/check-test-results.test.mjs",
    "test:e2e:ci": "node scripts/playwright.mjs test && node scripts/check-test-results.mjs playwright test-reports/playwright.json",
    "test:e2e:deps": "node scripts/playwright.mjs install-deps chromium",
    "audit:production": "node scripts/audit.mjs production",
    "audit:all": "node scripts/audit.mjs all",
    "verify:ci": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm run test:ci:guards && npm run test:ci && npm run build && npm run test:e2e:ci",
    "knip": "knip",
    "check:bundle": "node --test scripts/production-policy.test.mjs && node scripts/check-production-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/devtools-event-client": "0.5.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "i18next-cli": "^1.87.0",
    "jsdom": "^31.0.0",
    "knip": "^6.45.1",
    "msw": "^3.0.5",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@tanstack/form-core": {
      "@tanstack/devtools-event-client": "$@tanstack/devtools-event-client"
    }
  },
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  }
}
