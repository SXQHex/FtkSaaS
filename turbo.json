{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "verify": {
      "dependsOn": [
        "^typecheck"
      ],
      "cache": false,
      "env": [
        "FTK_TEST_TIMINGS"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ],
      "cache": false,
      "env": [
        "FTK_TEST_TIMINGS"
      ]
    },
    "test:clean": {
      "cache": false,
      "env": [
        "FTK_TEST_TIMINGS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/.oxlintrc.ui.json",
        "$TURBO_ROOT$/.oxfmtrc.json"
      ],
      "outputs": []
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "env": [
        "CI",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "test:coverage": {
      "cache": false,
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "quality": {
      "cache": false,
      "env": [
        "QUALITY_BASE"
      ],
      "outputs": []
    }
  }
}
